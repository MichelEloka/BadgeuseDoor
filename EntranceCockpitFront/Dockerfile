# Build stage
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci

# Build-time configuration passed from docker-compose build args
ARG ENTRANCE_FRONT_WS_URL
ARG ENTRANCE_FRONT_USERS_API_URL
ARG ENTRANCE_FRONT_USERS_DELETE_API_URL
ARG ENTRANCE_FRONT_MANUAL_OVERRIDE_URL
ARG ENTRANCE_FRONT_DOORS_API_URL
ARG ENTRANCE_FRONT_LOG_DETAILS_API_URL
ARG ENTRANCE_FRONT_MOCK_DEVICES_API_URL
ENV ENTRANCE_FRONT_WS_URL=$ENTRANCE_FRONT_WS_URL \
    ENTRANCE_FRONT_USERS_API_URL=$ENTRANCE_FRONT_USERS_API_URL \
    ENTRANCE_FRONT_USERS_DELETE_API_URL=$ENTRANCE_FRONT_USERS_DELETE_API_URL \
    ENTRANCE_FRONT_MANUAL_OVERRIDE_URL=$ENTRANCE_FRONT_MANUAL_OVERRIDE_URL \
    ENTRANCE_FRONT_DOORS_API_URL=$ENTRANCE_FRONT_DOORS_API_URL \
    ENTRANCE_FRONT_LOG_DETAILS_API_URL=$ENTRANCE_FRONT_LOG_DETAILS_API_URL \
    ENTRANCE_FRONT_MOCK_DEVICES_API_URL=$ENTRANCE_FRONT_MOCK_DEVICES_API_URL

COPY . .
RUN npm run build

# Runtime stage
FROM nginx:1.27-alpine
COPY --from=build /app/dist/entrance-cockpit-front/browser /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
